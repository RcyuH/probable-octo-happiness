{
  "model_dir": "${MODEL_DIR}",
  "adapter_path": "${DRAFT_ADAPTER_PATH}",
  "load_lora_path": "",
  "model_type": "qwen2",
  "train_option": "simplelr_abel_level3to5",
  "output_dir": "outputs/pros_fastgrpo",
  "log_file": "outputs/pros_fastgrpo/train.jsonl",
  "saved_model_dir": "outputs/pros_fastgrpo/target",
  "saved_draft_model_dir": "outputs/pros_fastgrpo/draft",
  "saved_statistics_dir": "outputs/pros_fastgrpo/statistics",
  "num_epochs": 1,
  "batch_size": 4,
  "accumulation_steps": 2,
  "draft_accumulation_steps": 1,
  "target_lr": 1e-6,
  "draft_lr": 1e-4,
  "train_draft": true,
  "use_lora": true,
  "max_length": 2048,
  "max_training_token": 3072,
  "max_training_padding_gap": 256,
  "repeated_generate_nums": 8,
  "grpo_iteration_num": 1,
  "temperature": 1.0,
  "top_p": 0.95,
  "top_k": 0,
  "beta": 0.0,
  "epsilon": 0.1,
  "objective": "fastgrpo",
  "advantage_estimator": "grpo",
  "loss_agg_mode": "seq-mean-token-mean",
  "drop_zero_std_groups": true,
  "tree_selector": "entropy",
  "tree_sampler": "pg",
  "tree_mu0": 0.0,
  "tree_tau0": 1.5,
  "tree_sigma0": 0.0,
  "tree_delta": 0.1,
  "tree_gibbs_sweeps": 5,
  "tree_gamma": 0.995,
  "tree_min_window_tokens": 1000,
  "tree_score_threshold": 1.0,
  "save_freq": 500,
  "log_freq": 1,
  "max_train_steps": 0
}
